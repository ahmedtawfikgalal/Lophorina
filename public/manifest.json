{
  "manifest_version": 3,
  "name": "Lophorina",
  "version": "0.1.0",
  "description": "Control YouTube with hand gestures: play, pause and skip. Video is processed on your device and never leaves it.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "pages/control-panel/index.html"
  },
  "action": {
    "default_title": "Open Lophorina",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube-content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-control": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Start / stop gesture control"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'"
  }
}
